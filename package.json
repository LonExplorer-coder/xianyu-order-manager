{
  "name": "xianyu-order-manager",
  "productName": "闲鱼订单管理",
  "version": "0.2.49",
  "description": "本机优先的闲鱼来源截图识别与订单管理工具",
  "main": ".vite/build/electron-main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:mac:portable": "electron-forge make --platform darwin --arch arm64",
    "make:windows:portable": "electron-forge make --platform win32 --arch x64",
    "make:mac:release": "XIANYU_MAC_RELEASE=1 electron-forge make --platform darwin --arch arm64",
    "verify:portable": "node scripts/verify-portable-archive.mjs",
    "verify:mac:release": "node scripts/verify-macos-release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:native-image-crop": "electron scripts/electron-native-image-crop-smoke.cjs",
    "test:credential-store": "node scripts/system-credential-smoke.mjs",
    "test:packaged-credential-store": "node scripts/run-packaged-credential-smoke.mjs",
    "acceptance:stage-one:capture": "node scripts/run-private-stage-one-capture.mjs",
    "acceptance:stage-one:verify": "node scripts/verify-stage-one-acceptance.mjs",
    "acceptance:stage-one:release": "node scripts/verify-stage-one-release.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "exceljs": "4.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "43.2.0",
    "jsdom": "30.0.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "yauzl": "3.3.1"
  },
  "pnpm": {
    "overrides": {
      "yauzl": "3.3.1"
    },
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
